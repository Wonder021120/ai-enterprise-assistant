# Copy this file to .env.docker and replace both placeholder secrets.
# Use only letters, digits, underscores and hyphens in POSTGRES_PASSWORD,
# because Compose embeds it directly in DATABASE_URL.

POSTGRES_DB=careerpilot_docker
POSTGRES_USER=careerpilot_app
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password

DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
